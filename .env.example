# Auth — change all of these before exposing the panel
ADMIN_USER=admin
# Used only once on first boot to seed a bcrypt hash into the SQLite DB.
# After that, change the password in Account — do not rely on this env value.
ADMIN_PASSWORD=change-me-strong-password
SECRET_KEY=replace-with-long-random-string

# AmneziaWG access
# docker_exec | local | demo
AWG_MODE=docker_exec
# Find with: docker ps --format '{{.Names}}' | grep -iE 'awg|amnezia'
# Do NOT rename the Amnezia container — the desktop app keys off the original name.
AWG_CONTAINER=amnezia-awg2
AWG_SHOW_CMD=awg show all dump
AWG_CONF_PATH=/opt/amnezia/awg/awg0.conf
AWG_CLIENTS_TABLE=/opt/amnezia/awg/clientsTable
AWG_INTERFACE=awg0

SCRAPE_INTERVAL_SEC=60
ONLINE_POLL_SEC=30
ONLINE_THRESHOLD_SEC=900
# Calendar day boundary for Today / quota periods (IANA name)
STATS_TIMEZONE=UTC

# true = Secure cookie (HTTPS / Cloudflare). false = HTTP on a LAN
SESSION_HTTPS_ONLY=true

# Public DNS name for Caddy (required for public HTTPS compose).
# Keep this in .env only — Caddyfile reads {$PUBLIC_HOSTNAME} so git pull cannot wipe it.
PUBLIC_HOSTNAME=

# Lock login / password-change after 5 failed attempts (seconds)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SEC=180

# Host /proc inside the app container (docker-compose mounts /proc → /host/proc)
HOST_PROC_PATH=/host/proc
# Host binary watched on Performance (CPU / RSS via /proc)
TELEMT_PATH=/usr/local/bin/telemt

# Cloudflare Access (Zero Trust) — second gate before panel password
# Enable after creating the Access application in the Zero Trust dashboard.
CF_ACCESS_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=int-cloud.cloudflareaccess.com
CF_ACCESS_AUD=
